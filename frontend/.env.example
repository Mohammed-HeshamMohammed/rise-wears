# Public origin of this site (used in sitemap, canonical URLs, structured data)
NEXT_PUBLIC_SITE_URL=https://rise-wear.store
# Backend API origin (browser) and optional internal origin for server-side rendering
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000

# Firebase web app config (Firebase console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local development only: lets you log in without Firebase (backend needs AUTH_DEV_MODE=true).
NEXT_PUBLIC_AUTH_DEV_MODE=false

# Search console / webmaster verification codes (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=

# Must match the backend REVALIDATE_SECRET
REVALIDATE_SECRET=
